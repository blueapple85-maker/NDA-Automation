# The server reads ../key.txt first. Never commit .env or key files.
# Optional key file path, relative to this project (or an absolute path).
OPENAI_API_KEY_FILE=
# Fallback only when the default key.txt file does not exist.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REVIEW_MODEL=gpt-5.4-mini
# Applied to GPT-5.4 models during legal drafting; extraction uses low reasoning.
OPENAI_REVIEW_REASONING=medium
# Limits include reasoning tokens. A truncated response is retried once at the
# larger cap; partial results are never used. Equal caps disable that retry.
OPENAI_REVIEW_MAX_OUTPUT_TOKENS=32000
OPENAI_REVIEW_RETRY_MAX_OUTPUT_TOKENS=64000
OPENAI_ANALYZE_MAX_OUTPUT_TOKENS=9000
OPENAI_ANALYZE_RETRY_MAX_OUTPUT_TOKENS=18000
PORT=4173
# Optional LibreOffice executable; Windows otherwise uses installed Microsoft Word.
SOFFICE_PATH=
